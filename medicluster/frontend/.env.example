# Runtime setting for npm start on the separate Render frontend web service.
# API requests stay on the frontend origin and are forwarded by server.js.
BACKEND_URL=https://medicluster-backend.onrender.com

# Optional public Vite settings, read at build time.
VITE_DISPATCH_URL=https://medicluster-dispatch-dix1.onrender.com
VITE_GOOGLE_MAPS_KEY=
