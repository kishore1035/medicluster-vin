# Public Supabase project configuration; never use a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# API includes /api. Leave empty when your frontend host proxies /api to the backend.
# Cross-origin production deployments require an HTTPS API URL and matching backend CORS origin.
VITE_API_URL=https://YOUR_DISPATCH_API.example.com/api

# Optional legacy Socket.IO server. Leave unset for Supabase Realtime deployment.
# VITE_WEBSOCKET_URL=https://YOUR_SOCKET_SERVER.example.com
